# Server
PORT=3000

# MongoDB connection string (note: the app reads MONGOOSEDB_RUL, sic)
MONGOOSEDB_RUL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/react-node-app

# Secret used to sign auth JWTs. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# PayPal REST app client id. This one is public by design: the server hands it
# to the browser at /api/config/paypal so the PayPal SDK can initialise.
PAYPAL_CLIENT_ID=your-paypal-client-id
